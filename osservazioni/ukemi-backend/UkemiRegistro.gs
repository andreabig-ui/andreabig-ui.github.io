:.9rem}dialog input{width:100%}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}\n@media(max-width:1200px){.workspace.with-summary{grid-template-columns:1fr}}@media(max-width:900px){.app{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:14px;display:grid;grid-template-columns:1fr 1fr}.brand{grid-column:1/-1;margin:0}.sidebar nav{grid-column:1/-1;grid-template-columns:repeat(3,1fr)}.sidebar .privacy,.sidebar>a{display:none}.side-block p{margin:4px 0}.sidebar .side-block:first-of-type{display:none}main{padding:16px}.stats-cards{grid-template-columns:repeat(2,1fr)}.toolbar{flex-wrap:wrap}.actions{position:static}}@media(max-width:520px){.sidebar nav{grid-template-columns:1fr}.setup label{min-width:40%;width:40%}h2{font-size:1.4rem}main{padding:10px}.stats-controls>*{width:100%}}\n@media print{.sidebar,.setup,.actions,.toolbar button,.stats-controls,#status,details{display:none}.app,.workspace{display:block}main{padding:0}.table-wrap{overflow:visible;max-height:none}th,td{position:static!important;min-width:0!important}td select{appearance:none;min-width:0;min-height:22px;font-size:9px}.card{box-shadow:none}body{font-size:10px}table{border-spacing:2px;font-size:10px}}\n</style></head><body>\n<div class=\"app\"><aside class=\"sidebar\"><div class=\"brand\"><b class=\"brand-mark\">SM</b><div><h1>Osservazioni SM</h1><small>Ukemi · classi prime</small></div></div><nav id=\"phases\" aria-label=\"Fasi della lezione\"></nav><button id=\"statsTab\" class=\"nav\">Statistiche</button><div class=\"side-block\"><b>Scala comune</b><p>0 · Da acquisire<br>1 · Con richiamo<br>2 · Autonomo<br>N/O · Non osservato<br>— · Non compilato</p></div><div class=\"side-block\" id=\"connection\"><b id=\"mode\">Archivio locale</b><p id=\"connectionInfo\">I dati restano su questo dispositivo.</p><button id=\"openSettings\">Collegamento condiviso</button></div><a href=\"./\" id=\"backLink\">Palla prigioniera</a><a href=\"capovolta.html\" id=\"capLink\">Capovolta</a><small class=\"privacy\">Classe e numero di registro. Nessun nome o dato sanitario.</small></aside>\n<main><header><div><p class=\"eyebrow\">LEZIONE UKEMI</p><h2 id=\"title\">Griglie di osservazione</h2><p id=\"subtitle\">Una scala comune per osservazioni confrontabili.</p></div><span class=\"badge\" id=\"version\">ukemi-1.0</span></header>\n<section id=\"observation\">\n<form id=\"sessionForm\" class=\"card setup\"><label>Anno scolastico<input id=\"year\" pattern=\"[0-9]{4}-[0-9]{2}\" required placeholder=\"2026-27\"></label><label>Classe<input id=\"classCode\" pattern=\"1[A-Za-z]\" maxlength=\"2\" required placeholder=\"1A\" autocapitalize=\"characters\"></label><label>Data<input id=\"date\" type=\"date\" required></label><label>Rilevazione<input id=\"attempt\" type=\"number\" value=\"1\" min=\"1\" max=\"100\" required></label><label>Codice docente<input id=\"observer\" maxlength=\"20\" placeholder=\"D01\" pattern=\"[A-Za-z0-9_-]{2,20}\" required autocapitalize=\"characters\"></label><label>N. alunni<input id=\"size\" type=\"number\" value=\"25\" min=\"1\" max=\"40\" required></label><button class=\"primary\" type=\"submit\">Apri griglia</button></form>\n<p class=\"hint\">Stessa classe, data e rilevazione richiamano la stessa scheda del docente. Per una nuova prova aumenta “Rilevazione” o cambia data.</p>\n<section class=\"card guide\"><h3 id=\"phaseTitle\"></h3><p id=\"phaseIntro\"></p><details><summary>Criteri e consegne da osservare</summary><div id=\"criteriaList\"></div></details><p class=\"hint\">Il “telefono” richiama orecchio e spalla. La guancia è un errore. Il peso non deve gravare su testa o collo. Il docente conferma ogni passaggio.</p></section>\n<div class=\"toolbar\"><span id=\"sessionLabel\">Apri una griglia per iniziare.</span><button id=\"toggleSummary\" aria-expanded=\"false\" aria-controls=\"summaryPanel\">Mostra riepilogo</button></div>\n<div class=\"workspace\" id=\"workspace\"><section class=\"card grid-card\"><div class=\"table-wrap\"><table id=\"grid\"><caption class=\"sr-only\">Osservazione degli alunni per criterio</caption></table></div></section><aside class=\"card\" id=\"summaryPanel\" hidden><h3>Questa fase</h3><div id=\"liveSummary\"></div><p class=\"hint\">I livelli descrivono l’esecuzione osservata. Nessun voto automatico e nessuna deduzione sulla causa dell’errore.</p></aside></div>\n<section class=\"actions\"><button id=\"undo\">Annulla ultimo</button><button id=\"save\" class=\"primary\">Salva fase</button><button id=\"send\" class=\"primary\">Invia al registro condiviso</button><button id=\"exportCSV\">Esporta CSV</button><button id=\"exportJSON\">Copia di sicurezza</button></section>\n</section>\n<section id=\"statistics\" hidden><section class=\"card stats-controls\"><label>Anno<select id=\"statsYear\"></select></label><label>Classe<select id=\"statsClass\"><option value=\"\">Tutte le classi</option></select></label><label>Fase<select id=\"statsPhase\"><option value=\"\">Tutte le fasi</option></select></label><button id=\"refreshStats\" class=\"primary\">Aggiorna dal registro</button><label class=\"button\">Importa copie dei colleghi<input id=\"importFiles\" type=\"file\" accept=\"application/json,.json\" multiple hidden></label><button id=\"sendImports\">Invia copie importate</button><button id=\"statsCSV\">Esporta statistiche CSV</button></section><p class=\"hint\" id=\"statsSource\"></p><div id=\"statsCards\" class=\"stats-cards\"></div><section class=\"card grid-card\"><div class=\"table-wrap\"><table id=\"statsGrid\"></table></div></section><section class=\"card guide\"><h3>Come leggere i risultati</h3><p>Per ogni ragazzo e fase compare l’ultima rilevazione: prima la data, poi il numero della rilevazione, infine la modifica più recente. Osservazioni ripetute e invii duplicati non aumentano il numero dei ragazzi.</p><p>“Autonomi %” usa soltanto i valori 0, 1 e 2 dello specifico criterio. N/O, celle vuote, assenze e non partecipazioni restano fuori dal denominatore. Si mostra sempre anche il numero di osservati.</p><p>* Vuoti: celle non compilate nelle schede ricevute. Le schede mai registrate si riconoscono dalla copertura.</p><p>Il totale atteso deriva dalle numerosità delle sole classi presenti nei dati filtrati. Non rappresenta le classi mai registrate. Confrontare criteri uguali, stessa fase e condizioni simili.</p></section></section>\n<p id=\"status\" role=\"status\" aria-live=\"polite\">Pronto.</p>\n</main></div>\n<dialog id=\"settings\"><form method=\"dialog\"><div class=\"dialog-head\"><h2>Raccolta condivisa</h2><button aria-label=\"Chiudi\">×</button></div><div id=\"hostedSettings\"><p>Inserisci la chiave personale assegnata dal coordinatore. La chiave del coordinatore consente anche di consultare i risultati complessivi.</p><label>Chiave personale<input id=\"accessKey\" type=\"password\" autocomplete=\"off\"></label><button type=\"button\" id=\"login\" class=\"primary\">Accedi al registro</button><p id=\"loginResult\" role=\"status\"></p><button type=\"button\" id=\"logout\">Disconnetti</button></div><div id=\"localSettings\"><p>Le griglie funzionano già sul dispositivo. Per raccogliere tutti i colleghi, il coordinatore attiva una sola volta il registro Google seguendo la guida.</p><p><a href=\"ukemi-attivazione.html\" target=\"_blank\" rel=\"noopener\">Istruzioni di attivazione</a></p><label>Indirizzo del registro condiviso<input id=\"webAppUrl\" type=\"url\" placeholder=\"https://script.google.com/macros/s/…/exec\"></label><button type=\"button\" id=\"saveEndpoint\">Memorizza indirizzo</button><button type=\"button\" id=\"openShared\" class=\"primary\">Apri il registro condiviso</button><p class=\"hint\">Prima di passare al registro, salva una copia di sicurezza. Puoi importarla nella versione condivisa e inviare le tue osservazioni.</p></div></form></dialog>\n<script>/*HOST_CONFIG*/</script><script>/* Criteri condivisi da interfaccia, statistiche e verifiche. Nessun dato degli alunni. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.UkemiCore=api;})(typeof globalThis!=='undefined'?globalThis:this,function(){\n'use strict';\nconst VERSION='ukemi-1.0';\nconst PHASES=[\n{id:'avviamento',title:'Avviamento motorio',short:'1 · Avviamento',criteria:[\n['AV01','Respiro e braccia','Coordina il movimento delle braccia con una respirazione regolare, senza trattenere l’aria.'],\n['AV02','Mobilità controllata','Esegue la sequenza di mobilità con appoggi stabili, gradualità e ampiezza personale controllata.'],\n['AV03','Orecchio e spalla','Mantiene il riferimento del telefono fra orecchio e spalla, distinguendo l’orecchio dalla guancia.']\n]},\n{id:'indietro',title:'Sbilanciamento e rullaggio indietro',short:'2 · Indietro',criteria:[\n['IN01','Palmo intero','Accompagna la discesa poggiando l’intero palmo, senza affidarsi alle sole dita.'],\n['IN02','Mano visibile','Mantiene lo sguardo sulla mano di appoggio durante il rullaggio.'],\n['IN03','Rullaggio laterale','Rulla sulla parte laterale della schiena, con discesa continua e senza urti sul sacro o sulla linea vertebrale.'],\n['IN04','Telefono stabile','Conserva la posizione orecchio–spalla durante il rullaggio, senza caricare testa o collo.'],\n['IN05','Piede opposto','Nella fase conclusiva cerca il terreno dietro la testa con il piede opposto alla spalla del telefono, entro l’ampiezza controllabile.']\n]},\n{id:'avanti',title:'Mae ukemi · preparazione e rotolamento',short:'3 · Mae ukemi',criteria:[\n['MA01','Quadrato iniziale','Dispone mani e ginocchia in un quadrato regolare e stabile.'],\n['MA02','Mano rovesciata','Rovescia una mano dal lato del pollice e ne fa scivolare il dorso verso l’esterno, accompagnando l’intrarotazione della spalla.'],\n['MA03','Spalla in discesa','Appoggia gradualmente la spalla dello stesso lato della mano rovesciata, senza urti.'],\n['MA04','Telefono opposto','Mantiene il telefono tra orecchio e spalla opposta a quella in discesa. Evita la sostituzione con la guancia e il carico sul collo.'],\n['MA05','Finestra visiva','Orienta lo sguardo verso la finestra tra le gambe, conservando la posizione della testa.'],\n['MA06','Equilibrio due piedi','Mantiene la posizione con entrambi i piedi e la spalla di appoggio. L’orecchio è un riferimento di posizione, non un sostegno del peso.'],\n['MA07','Equilibrio un piede','Mantiene la posizione con un solo piede, con la gamba libera distesa e alta quanto il controllo consente.'],\n['MA08','Rotolamento controllato','Supera gradualmente la base d’appoggio e accompagna il rotolamento senza precipitarsi o ricevere spinte.']\n]}\n];\nconst VALUES=[null,'NO',0,1,2];\nconst LABELS={'0':'Da acquisire','1':'Con richiamo','2':'Autonomo','NO':'Non osservato'};\nconst ALL_IDS=PHASES.flatMap(p=>p.criteria.map(c=>c[0]));\nfunction assert(v,m){if(!v)throw new Error(m);}\nfunction validateRecord(r){\nassert(r&&typeof r==='object','Osservazione mancante.');\nassert(r.rubricVersion===VERSION,'Versione dei criteri non compatibile.');\nfor(const k of ['id','sessionId'])assert(typeof r[k]==='string'&&/^[a-zA-Z0-9_-]{8,100}$/.test(r[k]),'Identificativo non valido.');\nassert(/^\\d{4}-\\d{2}$/.test(r.schoolYear),'Anno scolastico non valido.');\nconst yy=Number(r.schoolYear.slice(0,4));assert(r.schoolYear.slice(5)===String((yy+1)%100).padStart(2,'0'),'Anno scolastico incoerente.');\nassert(/^1[A-Z]$/.test(r.classCode),'Indicare una classe prima, per esempio 1A.');\nassert(/^\\d{4}-\\d{2}-\\d{2}$/.test(r.lessonDate)&&!isNaN(Date.parse(r.lessonDate))&&new Date(r.lessonDate+'T12:00:00Z').toISOString().slice(0,10)===r.lessonDate,'Data non valida.');\nassert(Number.isInteger(r.attempt)&&r.attempt>=1&&r.attempt<=100,'Rilevazione non valida.');\nassert(Number.isInteger(r.classSize)&&r.classSize>=1&&r.classSize<=40,'Numero alunni non valido.');\nassert(Number.isInteger(r.student)&&r.student>=1&&r.student<=r.classSize,'Numero di registro non valido.');\nassert(/^[A-Z0-9_-]{2,20}$/.test(r.observer),'Usare un codice docente di 2–20 caratteri.');\nassert(['presente','assente','non_partecipa'].includes(r.participation),'Partecipazione non valida.');\nconst p=PHASES.find(p=>p.id===r.phase);assert(p,'Fase non valida.');\nassert(r.values&&typeof r.values==='object'&&!Array.isArray(r.values),'Valori mancanti.');\nconst keys=Object.keys(r.values);assert(keys.length===p.criteria.length&&keys.every(k=>p.criteria.some(c=>c[0]===k)),'Criteri incoerenti con la fase.');\nassert(keys.every(k=>VALUES.includes(r.values[k])),'Livello non valido.');\nassert(r.participation==='presente'||keys.every(k=>r.values[k]===null),'Assenza e non partecipazione non possono avere punteggi.');\nassert(typeof r.modifiedAt==='string'&&/^\\d{4}-\\d{2}-\\d{2}T/.test(r.modifiedAt)&&!isNaN(Date.parse(r.modifiedAt))&&new Date(r.modifiedAt).toISOString()===r.modifiedAt,'Data della modifica non valida.');\n// Whitelist: niente campi liberi, nomi, note o chiavi di accesso nei dati salvati.\nreturn Object.fromEntries(['id','sessionId','rubricVersion','schoolYear','classCode','lessonDate','attempt','classSize','student','observer','participation','phase','values','modifiedAt'].map(k=>[k,k==='values'?Object.fromEntries(keys.map(id=>[id,r.values[id]])):r[k]]));\n}\nfunction mergeRecords(...groups){const map=new Map();for(const r0 of groups.flat()){const r=validateRecord(r0);const old=map.get(r.id);if(!old||Date.parse(r.modifiedAt)>Date.parse(old.modifiedAt))map.set(r.id,r);}return [...map.values()];}\nfunction latestRecords(records,filter={}){\nconst map=new Map();for(const r of mergeRecords(records)){\nif(filter.schoolYear&&r.schoolYear!==filter.schoolYear||filter.classCode&&r.classCode!==filter.classCode||filter.phase&&r.phase!==filter.phase)continue;\nconst key=[r.schoolYear,r.classCode,r.student,r.phase].join('|');const old=map.get(key);\nconst order=x=>[x.lessonDate,String(x.attempt).padStart(3,'0'),x.modifiedAt,x.id].join('|');\nif(!old||order(r)>order(old))map.set(key,r);\n}return [...map.values()];}\nfunction statistics(records,filter={}){\nconst valid=mergeRecords(records);const latest=latestRecords(valid,filter);const pupils=new Set();const withScores=new Set();const classes=new Map();\nfor(const r of latest){const key=[r.schoolYear,r.classCode,r.student].join('|');pupils.add(key);classes.set(r.schoolYear+'|'+r.classCode,Math.max(classes.get(r.schoolYear+'|'+r.classCode)||0,r.classSize));if(r.participation==='presente'&&Object.values(r.values).some(v=>typeof v==='number'))withScores.add(key);}\nconst roster=latestRecords(valid,{schoolYear:filter.schoolYear,classCode:filter.classCode});classes.clear();const rosterLatest=new Map();for(const r of roster){const k=r.schoolYear+'|'+r.classCode;const old=rosterLatest.get(k);if(!old||r.lessonDate+'|'+String(r.attempt).padStart(3,'0')+'|'+r.modifiedAt>old.lessonDate+'|'+String(old.attempt).padStart(3,'0')+'|'+old.modifiedAt)rosterLatest.set(k,r);}for(const [k,r] of rosterLatest)classes.set(k,r.classSize);\nconst criteria=PHASES.filter(p=>!filter.phase||p.id===filter.phase).flatMap(p=>p.criteria.map(c=>{\nconst a=latest.filter(r=>r.phase===p.id&&r.participation==='presente');const counts=[0,0,0];let no=0,blank=0;for(const r of a){const v=r.values[c[0]];if(typeof v==='number')counts[v]++;else if(v==='NO')no++;else blank++;}\nconst assessed=counts.reduce((s,v)=>s+v,0);return {phase:p.id,id:c[0],label:c[1],counts,no,blank,assessed,autonomous:assessed?counts[2]/assessed:null};}));\nreturn {latest,pupils:pupils.size,withScores:withScores.size,classCount:classes.size,expected:[...classes.values()].reduce((s,v)=>s+v,0),criteria};\n}\nfunction csv(rows){const q=v=>'\"'+String(v??'').replace(/^[=+@-]/,\"'<script src=\"ukemi-core.js\"></script>\").replaceAll('\"','\"\"')+'\"';return '\\ufeff'+rows.map(r=>r.map(q).join(';')).join('\\r\\n');}\nfunction recordsCSV(records){return csv([['anno_scolastico','classe','registro','data','rilevazione','docente','fase','partecipazione','criterio','livello','descrizione','id_osservazione'],...mergeRecords(records).flatMap(r=>Object.entries(r.values).map(([id,v])=>[r.schoolYear,r.classCode,r.student,r.lessonDate,r.attempt,r.observer,r.phase,r.participation,id,v===null?'':v,v===null?'Non compilato':LABELS[v],r.id]))]);}\nreturn {VERSION,PHASES,ALL_IDS,VALUES,LABELS,validateRecord,mergeRecords,latestRecords,statistics,csv,recordsCSV};\n});\n</script><script>(function(){'use strict';\nconst C=window.UkemiCore,$=id=>document.getElementById(id),KEY='sm_ukemi_v1';\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst uid=()=>crypto.randomUUID().replaceAll('-','');\nconst today=()=>{const d=new Date();return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');};\nconst yearNow=()=>{const d=new Date(),y=d.getFullYear()-(d.getMonth()<8?1:0);return `${y}-${String((y+1)%100).padStart(2,'0')}`;};\nconst hosted=!!(window.google&&google.script&&google.script.run);\nlet db={sessions:[],records:[],imports:[],pending:[],meta:{schoolYear:yearNow(),classCode:'1A',lessonDate:today(),attempt:1,classSize:25,observer:''}},phase=0,session=null,undo=[],token='',identity=null,remoteRecords=null,busy=false;\nfunction say(text,error=false){$('status').textContent=text;$('status').classList.toggle('error',error);}\nfunction persist(){try{localStorage.setItem(KEY,JSON.stringify(db));return true;}catch(e){say('Salvataggio sul dispositivo non riuscito. Esporta subito una copia di sicurezza.',true);return false;}}\ntry{const raw=localStorage.getItem(KEY);if(raw){const old=JSON.parse(raw);if(!Array.isArray(old.sessions)||!Array.isArray(old.pending))throw Error('Archivio locale non valido');db={...db,...old,records:C.mergeRecords(old.records||[]),imports:C.mergeRecords(old.imports||[])};}}catch(e){say('Archivio locale non leggibile. Non viene sovrascritto: ricarica o ripristina una copia di sicurezza.',true);$('observation').inert=true;throw e;}\nfunction rpc(name,arg){return new Promise((resolve,reject)=>{google.script.run.withSuccessHandler(resolve).withFailureHandler(e=>reject(Error(e.message||'Registro non raggiungibile.')))[name](arg);});}\nfunction readMeta(){return {schoolYear:$('year').value.trim(),classCode:$('classCode').value.trim().toUpperCase(),lessonDate:$('date').value,attempt:Number($('attempt').value),classSize:Number($('size').value),observer:$('observer').value.trim().toUpperCase()};}\nfunction setForm(m){for(const [id,k] of [['year','schoolYear'],['classCode','classCode'],['date','lessonDate'],['attempt','attempt'],['observer','observer'],['size','classSize']])$(id).value=m[k];}\nfunction blankRecord(s,student,p){return {id:s.id+'_'+p.id+'_'+student,sessionId:s.id,rubricVersion:C.VERSION,...s.meta,student,participation:'presente',phase:p.id,values:Object.fromEntries(p.criteria.map(c=>[c[0],null])),modifiedAt:new Date().toISOString()};}\nfunction validateMeta(m){C.validateRecord(blankRecord({id:'validation000',meta:m},1,C.PHASES[0]));}\nfunction matchesMeta(a,b){return ['schoolYear','classCode','lessonDate','attempt','observer'].every(k=>a[k]===b[k]);}\nfunction openSession(){if(!$('sessionForm').reportValidity())return;try{const m=readMeta();validateMeta(m);if(hosted&&(!identity||identity.id!==m.observer))throw Error('Accedi con la tua chiave personale prima di aprire la griglia.');\nlet found=db.sessions.find(s=>matchesMeta(s.meta,m));\nif(found&&found.meta.classSize!==m.classSize){const affected=db.records.some(r=>r.sessionId===found.id&&r.student>m.classSize);if(affected)throw Error('La riduzione escluderebbe alunni già osservati. Mantieni la numerosità attuale.');found.meta.classSize=m.classSize;for(const r of db.records.filter(r=>r.sessionId===found.id)){r.classSize=m.classSize;r.modifiedAt=new Date().toISOString();}}\nif(!found){found={id:uid(),meta:m};db.sessions.push(found);}session=found;db.meta=m;undo=[];persist();renderGrid();say('Griglia aperta. Le modifiche si salvano anche sul dispositivo.');}catch(e){say(e.message,true);}}\nfunction currentRecord(student,p=C.PHASES[phase]){return db.records.find(r=>r.id===session.id+'_'+p.id+'_'+student);}\nfunction updateRecord(student,fn){if(!session)return;let r=currentRecord(student);undo.push({id:session.id+'_'+C.PHASES[phase].id+'_'+student,before:r?JSON.parse(JSON.stringify(r)):null});if(!r){r=blankRecord(session,student,C.PHASES[phase]);db.records.push(r);}fn(r);r.modifiedAt=new Date().toISOString();if(persist())say('Modifica salvata sul dispositivo. Usa “Salva fase” per preparare l’invio.');renderSummary();}\nfunction option(value,label,selected){return `<option value=\"${value}\"${selected?' selected':''}>${label}</option>`;}\nfunction renderGrid(){const p=C.PHASES[phase];$('sessionLabel').textContent=session?`${session.meta.classCode} · ${session.meta.lessonDate.split('-').reverse().join('/')} · rilevazione ${session.meta.attempt} · ${session.meta.observer}`:'Apri una griglia per iniziare.';\n$('grid').innerHTML='<caption class=\"sr-only\">'+esc(p.title)+'</caption><thead><tr><th scope=\"col\">N. reg.</th><th scope=\"col\">Presenza</th>'+p.criteria.map(c=>`<th scope=\"col\" title=\"${esc(c[2])}\">${c[0]}<small>${esc(c[1])}</small></th>`).join('')+'</tr></thead><tbody></tbody>';\n$('save').disabled=!session;$('send').disabled=!session;$('undo').disabled=!undo.length;\nif(!session){renderSummary();return;}\nfor(let n=1;n<=session.meta.classSize;n++){\nconst r=currentRecord(n),presence=r?.participation||'presente';const tr=document.createElement('tr');\ntr.innerHTML=`<th scope=\"row\">${String(n).padStart(2,'0')}</th><td class=\"participation\"><select aria-label=\"Partecipazione alunno ${n}\">${[['presente','Presente'],['assente','Assente'],['non_partecipa','Non partecipa']].map(([v,l])=>option(v,l,v===presence)).join('')}</select></td>`;\ntr.querySelector('select').addEventListener('change',e=>{const value=e.target.value;const old=currentRecord(n);if(value!=='presente'&&old&&Object.values(old.values).some(v=>v!==null)&&!confirm('Rimuovere i livelli di questa fase per registrare la non partecipazione?')){e.target.value=old.participation;return;}updateRecord(n,x=>{x.participation=value;if(value!=='presente')x.values=Object.fromEntries(p.criteria.map(c=>[c[0],null]));});renderGrid();});\nfor(const c of p.criteria){const td=document.createElement('td'),select=document.createElement('select');const v=r?r.values[c[0]]:null;select.dataset.value=v===null?'':String(v);select.setAttribute('aria-label',`Alunno ${n}, ${c[0]} ${c[1]}`);select.title=c[2];select.disabled=presence!=='presente';select.innerHTML=[['','—'],['NO','N/O'],['0','0'],['1','1'],['2','2']].map(([value,label])=>option(value,label,(v===null?'':String(v))===value)).join('');select.onchange=()=>{const value=select.value;updateRecord(n,x=>x.values[c[0]]=value===''?null:value==='NO'?'NO':Number(value));select.dataset.value=value;$('undo').disabled=false;};td.append(select);tr.append(td);}\n$('grid').querySelector('tbody').append(tr);\n}renderSummary();}\nfunction renderSummary(){if(!session){$('liveSummary').textContent='Nessuna griglia aperta.';return;}const rows=db.records.filter(r=>r.sessionId===session.id&&r.phase===C.PHASES[phase].id),num=rows.filter(r=>r.participation==='presente'&&Object.values(r.values).some(v=>typeof v==='number')).length;const complete=rows.filter(r=>r.participation==='presente'&&Object.values(r.values).every(v=>v!==null)).length;const unobserved=rows.reduce((s,r)=>s+Object.values(r.values).filter(v=>v==='NO').length,0);const absent=rows.filter(r=>r.participation==='assente').length,non=rows.filter(r=>r.participation==='non_partecipa').length;$('liveSummary').innerHTML=`<p><b>${num}</b> alunni con livelli registrati</p><p><b>${complete}</b> schede senza celle vuote</p><p><b>${unobserved}</b> criteri N/O</p><p><b>${absent}</b> assenti · <b>${non}</b> non partecipanti</p><p><b>${db.pending.length}</b> invii in attesa</p>`;}\nfunction selectPhase(i){phase=i;document.querySelectorAll('#phases button').forEach((b,j)=>b.classList.toggle('active',j===i));$('statsTab').classList.remove('active');$('statistics').hidden=true;$('observation').hidden=false;const p=C.PHASES[i];$('title').textContent=p.short;$('phaseTitle').textContent=p.title;$('phaseIntro').textContent=['Respirazione, mobilità globale e posizione della testa.','Discesa accompagnata, sguardo sulla mano e percorso laterale.','Dal quadrato degli appoggi al rotolamento, dopo verifica dei prerequisiti.'][i];$('criteriaList').innerHTML=p.criteria.map(c=>`<div class=\"criterion\"><b>${c[0]} · ${esc(c[1])}</b><span>${esc(c[2])}</span></div>`).join('');undo=[];renderGrid();if(!hosted){const url=new URL(location.href);url.searchParams.set('fase',String(i+1));history.replaceState(null,'',url);} }\nfunction queueRecords(records){if(!records.length)throw Error('Nessuna osservazione da salvare.');const batch={submissionId:uid(),rubricVersion:C.VERSION,records:records.map(C.validateRecord)};db.pending.push(batch);if(!persist())throw Error('Invio non preparato: salvataggio locale non disponibile.');return batch;}\nfunction savePhase(){if(!session)return false;try{for(let n=1;n<=session.meta.classSize;n++){if(!currentRecord(n))db.records.push(blankRecord(session,n,C.PHASES[phase]));}queueRecords(db.records.filter(r=>r.sessionId===session.id&&r.phase===C.PHASES[phase].id));renderSummary();say(hosted?'Fase salvata. Ora puoi inviarla al registro condiviso.':'Fase salvata sul dispositivo. Esporta una copia o apri il registro condiviso per raccogliere i colleghi.');return true;}catch(e){say(e.message,true);return false;}}\nasync function sendPending(){if(busy)return;if(!hosted){$('settings').showModal();return;}if(!identity){$('settings').showModal();say('Accedi con la tua chiave per inviare.',true);return;}const mine=db.pending.filter(b=>b.records.every(r=>(identity.role==='admin'||r.observer===identity.id)));if(!mine.length){say('Nessun invio in attesa per questo docente.