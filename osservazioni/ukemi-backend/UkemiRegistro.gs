hScores,'Ragazzi con almeno un livello'],[s.expected,'Alunni attesi nelle classi registrate'],[s.classCount,'Classi presenti'],[s.pupils,'Ragazzi con una scheda, incluse assenze']].map(([v,l])=>`<div class=\"stat\"><strong>${v}</strong><span>${l}</span></div>`).join('');$('statsGrid').innerHTML='<thead><tr><th>Criterio</th><th>0</th><th>1</th><th>2</th><th>Osservati</th><th>N/O</th><th>Vuoti*</th><th>Autonomi %</th></tr></thead><tbody>'+s.criteria.map(c=>`<tr><td><b>${c.id}</b><br>${esc(c.label)}</td>${c.counts.map(v=>`<td>${v}</td>`).join('')}<td>${c.assessed}</td><td>${c.no}</td><td>${c.blank}</td><td>${c.autonomous===null?'—':`${(c.autonomous*100).toFixed(1)}%<div class=\"bar\"><i style=\"width:${c.autonomous*100}%\"></i></div>`}</td></tr>`).join('')+'</tbody>';}\nasync function refreshStats(){if(!hosted||identity?.role!=='admin'){say('Per leggere tutti i colleghi, apri il registro e accedi con la chiave del coordinatore.',true);return;}$('refreshStats').disabled=true;try{const out=await rpc('apiRead',{token});remoteRecords=C.mergeRecords(out.records);populateFilters();renderStats();say('Statistiche aggiornate dal registro condiviso.');}catch(e){say(e.message,true);}finally{$('refreshStats').disabled=false;}}\nasync function importFiles(event){try{let imported=[];for(const f of event.target.files){if(f.size>5e6)throw Error('Copia troppo grande (massimo 5 MB per file).');const obj=JSON.parse(await f.text());if(obj.format!=='sm-ukemi-backup-v1'||!Array.isArray(obj.records)||obj.records.length>20000)throw Error('Formato della copia non riconosciuto.');imported=C.mergeRecords(imported,obj.records);}db.imports=C.mergeRecords(db.imports,imported);if(!persist())throw Error('Impossibile conservare la copia importata.');if(hosted&&identity){const own=imported.filter(r=>identity.role==='admin'||r.observer===identity.id);for(let i=0;i<own.length;i+=40)queueRecords(own.slice(i,i+40));}remoteRecords=null;populateFilters();renderStats();say(`${imported.length} schede lette. I duplicati si uniscono per identificativo. ${hosted?'Le tue schede importate sono in attesa di invio.':''}`);}catch(e){say('Importazione non completata: '+e.message,true);}finally{event.target.value='';}}\nfunction syncIdentity(){const ok=!!identity;$('mode').textContent=hosted?(ok?'Registro condiviso · '+identity.id:'Registro condiviso · accesso richiesto'):'Archivio locale';$('connectionInfo').textContent=hosted?'I dati entrano nel foglio soltanto dopo un invio confermato.':'Le altre compilazioni non arrivano a questo dispositivo.';$('observer').readOnly=hosted;if(ok){$('observer').value=identity.id;db.meta.observer=identity.id;persist();}$('refreshStats').hidden=!hosted||identity?.role!=='admin';}\n$('sessionForm').onsubmit=e=>{e.preventDefault();openSession();};\nC.PHASES.forEach((p,i)=>{const b=document.createElement('button');b.className='nav';b.textContent=p.short;b.onclick=()=>selectPhase(i);$('phases').append(b);});\n$('statsTab').onclick=()=>{$('observation').hidden=true;$('statistics').hidden=false;document.querySelectorAll('#phases button').forEach(b=>b.classList.remove('active'));$('statsTab').classList.add('active');$('title').textContent='Statistiche delle classi prime';populateFilters();renderStats();};\n$('statsPhase').innerHTML+=C.PHASES.map(p=>option(p.id,p.short,false)).join('');for(const id of ['statsYear','statsClass','statsPhase'])$(id).onchange=()=>{if(id==='statsYear')populateFilters();renderStats();};\n$('save').onclick=savePhase;$('send').onclick=()=>{if(hosted&&savePhase())sendPending();else if(!hosted)$('settings').showModal();};\n$('undo').onclick=()=>{const op=undo.pop();if(!op)return;db.records=db.records.filter(r=>r.id!==op.id);if(op.before){op.before.modifiedAt=new Date().toISOString();db.records.push(op.before);}else{const m=op.id.match(/_(avviamento|indietro|avanti)_(\\d+)$/);const r=blankRecord(session,Number(m[2]),C.PHASES.find(p=>p.id===m[1]));db.records.push(r);}persist();renderGrid();say('Ultima modifica annullata. Per correggere il registro condiviso, salva e invia la fase.');};\n$('toggleSummary').onclick=()=>{const show=$('summaryPanel').hidden;$('summaryPanel').hidden=!show;$('workspace').classList.toggle('with-summary',show);$('toggleSummary').setAttribute('aria-expanded',String(show));$('toggleSummary').textContent=show?'Nascondi riepilogo':'Mostra riepilogo';};\n$('exportCSV').onclick=()=>download('ukemi_osservazioni.csv',C.recordsCSV(allLocal()),'text/csv;charset=utf-8');\n$('exportJSON').onclick=()=>download('ukemi_copia_'+today()+'.json',JSON.stringify({format:'sm-ukemi-backup-v1',rubricVersion:C.VERSION,records:allLocal()},null,2),'application/json');\n$('statsCSV').onclick=()=>{const s=getStats(),rows=[['criterio','fase','livello_0','livello_1','livello_2','osservati','non_osservati','vuoti','autonomi_percentuale'],...s.criteria.map(c=>[c.id,c.phase,...c.counts,c.assessed,c.no,c.blank,c.autonomous===null?'':(c.autonomous*100).toFixed(1)])];download('ukemi_statistiche.csv',C.csv(rows),'text/csv;charset=utf-8');};\n$('sendImports').onclick=sendPending;$('sendImports').hidden=!hosted;$('importFiles').onchange=importFiles;$('refreshStats').onclick=refreshStats;$('openSettings').onclick=()=>$('settings').showModal();\n$('login').onclick=async()=>{try{const candidate=$('accessKey').value.trim();if(!candidate)throw Error('Inserisci la chiave personale.');identity=await rpc('apiLogin',{token:candidate});token=candidate;$('accessKey').value='';session=null;syncIdentity();renderGrid();$('loginResult').textContent=`Accesso riuscito: ${identity.id}${identity.role==='admin'?' · coordinatore':''}.`;}catch(e){$('loginResult').textContent='Accesso non riuscito: '+e.message;}};\n$('logout').onclick=()=>{token='';identity=null;remoteRecords=null;session=null;syncIdentity();renderGrid();populateFilters();renderStats();$('loginResult').textContent='Accesso chiuso.';};\n$('saveEndpoint').onclick=()=>{try{const u=new URL($('webAppUrl').value.trim());if(u.origin!=='https://script.google.com'||!/^\\/macros\\/s\\/[a-zA-Z0-9_-]+\\/exec$/.test(u.pathname)||u.search||u.hash)throw Error('Usa l’indirizzo /exec della distribuzione Apps Script.');localStorage.setItem('sm_ukemi_endpoint',u.href);say('Indirizzo memorizzato. Apri il registro condiviso.');}catch(e){say(e.message,true);}};\n$('openShared').onclick=()=>{const u=localStorage.getItem('sm_ukemi_endpoint');if(!u){say('Memorizza prima l’indirizzo del registro.',true);return;}window.open(u,'_blank','noopener');};\n$('hostedSettings').hidden=!hosted;$('localSettings').hidden=hosted;\ntry{$('webAppUrl').value=localStorage.getItem('sm_ukemi_endpoint')||'';}catch{}\nif(hosted){$('backLink').href='https://andreabig-ui.github.io/osservazioni/';$('backLink').target='_top';$('capLink').href='https://andreabig-ui.github.io/osservazioni/capovolta.html';$('capLink').target='_top';}\nsetForm(db.meta);syncIdentity();const requested=Number(window.UKEMI_INITIAL_PHASE||new URLSearchParams(location.search).get('fase')||1);selectPhase([1,2,3].includes(requested)?requested-1:0);\nif(hosted)$('settings').showModal();\nif(!hosted&&'serviceWorker' in navigator)navigator.serviceWorker.register('service-worker.js').catch(()=>{});\n})();\n</script>\n</body></html>\n";
/* Registro Ukemi. Configurazione e chiavi restano nelle proprietà dello script. */
const UKEMI_VERSION_ = 'ukemi-1.0';
const HEADERS_ = ['id_invio','ricevuto_il','docente_autenticato','schede_json'];

// Eseguire UNA VOLTA dall'editor Apps Script con l'account scolastico.
// Il suffisso _ impedisce la chiamata di questa funzione da google.script.run.
function setupUkemi_() {
  const props=PropertiesService.getScriptProperties();
  if(props.getProperty('UKEMI_SHEET_ID')) {
    console.log('Registro già configurato: https://docs.google.com/spreadsheets/d/'+props.getProperty('UKEMI_SHEET_ID'));
    return;
  }
  const book=SpreadsheetApp.create('Ukemi · Registro condiviso classi prime');
  const sheet=book.getSheets()[0];sheet.setName('Invii');sheet.appendRow(HEADERS_);sheet.setFrozenRows(1);
  const setup=book.insertSheet('Accessi');
  setup.appendRow(['Ruolo','Codice docente','Chiave personale (riservata)']);
  const credentials=[];
  for(let i=1;i<=10;i++){
    const id='D'+String(i).padStart(2,'0'),token=Utilities.getUuid()+Utilities.getUuid();
    credentials.push({id,role:'teacher',hash:hash_(token)});
    setup.appendRow(['Docente',id,token]);
  }
  const admin=Utilities.getUuid()+Utilities.getUuid();
  credentials.push({id:'COORD01',role:'admin',hash:hash_(admin)});
  setup.appendRow(['Coordinatore','COORD01',admin]);
  setup.appendRow(['Non condividere questo foglio. Consegnare a ogni docente soltanto la propria riga.','','']);
  setup.autoResizeColumns(1,3);sheet.autoResizeColumns(1,3);
  props.setProperties({UKEMI_SHEET_ID:book.getId(),UKEMI_CREDENTIALS:JSON.stringify(credentials)});
  console.log('Registro pronto: '+book.getUrl());
}
function hash_(token){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(token),Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function auth_(arg){
  if(!arg||typeof arg.token!=='string'||arg.token.length>200)throw Error('Chiave personale non valida.');
  const hash=hash_(arg.token),arr=JSON.parse(PropertiesService.getScriptProperties().getProperty('UKEMI_CREDENTIALS')||'[]');
  const match=arr.find(x=>x.hash===hash);if(!match)throw Error('Chiave personale non valida o revocata.');return match;
}
function apiLogin(arg){const who=auth_(arg);return {id:who.id,role:who.role};}
function core_(){return UkemiCore;}
function book_(){const id=PropertiesService.getScriptProperties().getProperty('UKEMI_SHEET_ID');if(!id)throw Error('Il coordinatore deve inizializzare il registro.');return SpreadsheetApp.openById(id);}
function validateBatch_(batch,who){
  if(!batch||batch.rubricVersion!==UKEMI_VERSION_||!Array.isArray(batch.records)||batch.records.length<1||batch.records.length>40)throw Error('Invio non valido (massimo 40 schede).');
  if(typeof batch.submissionId!=='string'||!/^[a-zA-Z0-9_-]{8,100}$/.test(batch.submissionId))throw Error('Identificativo invio non valido.');
  const core=core_(),ids=new Set();
  return batch.records.map(input=>{
    const r=core.validateRecord(input);
    if(who.role!=='admin'&&r.observer!==who.id)throw Error('Il codice docente non corrisponde alla chiave personale.');
    if(Date.parse(r.modifiedAt)>Date.now()+300000)throw Error('L’orologio del dispositivo è troppo avanti. Correggerlo e riprovare.');
    if(ids.has(r.id))throw Error('Scheda ripetuta nello stesso invio.');ids.add(r.id);return r;
  });
}
function apiSave(arg){
  const who=auth_(arg),batch=arg.batch,records=validateBatch_(batch,who),encoded=JSON.stringify(records);
  if(encoded.length>45000)throw Error('Invio troppo grande.');
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
    const sheet=book_().getSheetByName('Invii'),last=sheet.getLastRow();
    // Ricevuta idempotente. Un timeout del browser può essere ritentato senza duplicare l'invio.
    if(last>1){const rows=sheet.getRange(2,1,last-1,4).getValues();const old=rows.find(row=>row[0]===batch.submissionId);if(old){if(old[2]!==who.id||old[3]!==encoded)throw Error('Identificativo già utilizzato per un altro contenuto.');return {ok:true,submissionId:batch.submissionId,duplicate:true};}}
    // Un invio = una riga. Un'unica scrittura conserva insieme identificativo e dati.
    sheet.getRange(last+1,1,1,4).setValues([[batch.submissionId,new Date().toISOString(),who.id,encoded]]);
    SpreadsheetApp.flush();return {ok:true,submissionId:batch.submissionId,count:records.length};
  }finally{lock.releaseLock();}
}
function apiRead(arg){
  const who=auth_(arg);if(who.role!=='admin')throw Error('La consultazione complessiva è riservata al coordinatore.');
  const sheet=book_().getSheetByName('Invii'),last=sheet.getLastRow();if(last<2)return {records:[]};
  const values=sheet.getRange(2,4,last-1,1).getValues();
  const records=[];for(const row of values){if(row[0])records.push.apply(records,JSON.parse(row[0]));}
  return {records:core_().mergeRecords(records)};
}
function doGet(e){
  const phase=Number(e&&e.parameter&&e.parameter.fase)||1;
  const html=UKEMI_APP_HTML_.replace('/*HOST_CONFIG*/','window.UKEMI_INITIAL_PHASE='+([1,2,3].includes(phase)?phase:1)+';');
  return HtmlService.createHtmlOutput(html).setTitle('Ukemi · Registro condiviso').addMetaTag('viewport','width=device-width,initial-scale=1,viewport-fit=cover');
}
